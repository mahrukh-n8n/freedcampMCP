# Freedcamp API credentials (get from Freedcamp Settings → API)
FREEDCAMP_API_KEY=your_api_key_here
FREEDCAMP_API_SECRET=your_api_secret_here

# Optional: Custom base URL for self-hosted Freedcamp
# FREEDCAMP_API_URL=https://freedcamp.com

# Optional: Logging (debug | info | warn | error)
# LOG_LEVEL=info

# Optional: Request timeout in ms
# REQUEST_TIMEOUT_MS=30000

# Optional: Name resolution cache TTL in ms
# CACHE_TTL_MS=60000

# Optional: Max concurrent API requests
# MAX_CONCURRENT_REQUESTS=6